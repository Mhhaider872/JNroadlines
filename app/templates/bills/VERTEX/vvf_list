<h1>Invoices</h1>
<table>
  <tr>
    <th>ID</th><th>Company</th><th>Date</th><th>GST</th><th>PAN</th><th>Details</th>
  </tr>
  {% for inv in invoices %}
  <tr>
    <td>{{ inv.id }}</td>
    <td>{{ inv.company }}</td>
    <td>{{ inv.date }}</td>
    <td>{{ inv.gst }}</td>
    <td>{{ inv.pan }}</td>
    <td><a href="{% url 'vvfmulti_detail' inv.id %}">View Items</a></td>
  </tr>
  {% empty %}
  <tr><td colspan="6">No invoices created yet.</td></tr>
  {% endfor %}
</table>
